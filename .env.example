# Munder Difflin — environment configuration
# Copy to .env and fill in. Pick ONE provider via MUNDER_PROVIDER.

# Which LLM provider to use: "openai" (default) or "azure".
MUNDER_PROVIDER=openai

# ---------------------------------------------------------------------------
# Provider: openai  (OpenAI-compatible endpoint — the Udacity/Vocareum proxy)
# ---------------------------------------------------------------------------
UDACITY_OPENAI_API_KEY=your_key_here
# Defaults to the Vocareum proxy; override if needed:
# UDACITY_BASE_URL=https://openai.vocareum.com/v1
# Model name served by the endpoint:
MUNDER_MODEL=gpt-4o

# ---------------------------------------------------------------------------
# Provider: azure  (Azure AI Foundry / Azure OpenAI)
# Set MUNDER_PROVIDER=azure above, then fill these in.
# ---------------------------------------------------------------------------
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=your_azure_key_here
# AZURE_OPENAI_API_VERSION=2025-01-01-preview   # use a current version; gpt-5-class models need a recent one
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name   # the deployment, used as the model name

# ---------------------------------------------------------------------------
# Database file locations (optional; sensible defaults are used)
# ---------------------------------------------------------------------------
# MUNDER_LIVE_DB=munder_live.db
# MUNDER_EVAL_DB=munder_eval.db
